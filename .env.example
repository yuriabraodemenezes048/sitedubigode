# Copie para .env.local e preencha. Nenhuma dessas variáveis é exposta no
# frontend a menos que use o prefixo NEXT_PUBLIC_.

# URL de produção (usada em SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://drinksdubigode.com.br

# Recebimento dos orçamentos por e-mail (Resend — https://resend.com)
# Obrigatória para enviar. Sem ela, o lead só vai para o log do servidor.
RESEND_API_KEY=
# Para onde os pedidos são enviados (padrão: e-mail de contato do site)
LEAD_NOTIFY_EMAIL=drinksdubigode@gmail.com
# Remetente. Sem domínio verificado, use onboarding@resend.dev (só entrega no
# e-mail da conta Resend). Com domínio verificado: contato@seudominio.com.br
# MAIL_FROM=Drinks du Bigode <onboarding@resend.dev>

# Proteção anti-spam (estrutura já pronta no backend)
# TURNSTILE_SECRET_KEY=
# RECAPTCHA_SECRET_KEY=

# Analytics (só carregam após consentimento no banner de cookies)
# NEXT_PUBLIC_GA4_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
