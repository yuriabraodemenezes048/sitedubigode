# Copie para .env.local e preencha. Nenhuma dessas variáveis é exposta no
# frontend a menos que use o prefixo NEXT_PUBLIC_.

# URL de produção (usada em SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://drinksdubigode.com.br

# Integração de leads do formulário (escolha uma no route.ts)
# RESEND_API_KEY=
# LEAD_NOTIFY_EMAIL=contato@drinksdubigode.com.br

# Proteção anti-spam (estrutura já pronta no backend)
# TURNSTILE_SECRET_KEY=
# RECAPTCHA_SECRET_KEY=

# Analytics (só carregam após consentimento no banner de cookies)
# NEXT_PUBLIC_GA4_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
